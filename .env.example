# Go-Chat — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# ─── PocketBase ───────────────────────────────────────────────────────────────
# Local PocketBase URL (dev only)
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# ─── Turso (LibSQL Cloud DB) ──────────────────────────────────────────────────
# These will be active when PocketBase pre-built binary supports LibSQL natively.
# For now, set these in Render dashboard as secrets.
TURSO_DATABASE_URL=libsql://go-chat-surya-namo.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ─── Cloudflare R2 (Media Storage) ───────────────────────────────────────────
# Sign up at dash.cloudflare.com → R2 → Create bucket
# Free: 10 GB storage, 1M requests/month
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=go-chat-media
R2_PUBLIC_URL=https://your-bucket.your-subdomain.r2.dev
